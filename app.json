{
  "expo": {
    "name": "FTJ Exports",
    "slug": "ftj-customer-app",
    "version": "1.0.0",
    "scheme": "ftjcustomer",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.ftjcustomer"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
